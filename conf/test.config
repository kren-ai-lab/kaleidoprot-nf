// Small CPU-only run on public PDB entries. Fetch the data first:
//   python examples/test/fetch_test_data.py examples/test/data
params {
    input = "${projectDir}/examples/test/data/sequences.csv"
    structures = "${projectDir}/examples/test/data/manifest.csv"
    label_column = 'family'
    mantel_permutations = 99
    outdir = 'results_test'
}

process {
    // Caps every label so the test fits a laptop or a small VM.
    resourceLimits = [cpus: 2, memory: 3.GB, time: 1.h]
}
