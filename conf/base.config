process {
    cpus = 1
    memory = '4 GB'
    time = '2h'
    errorStrategy = 'terminate'

    withLabel: 'process_single' {
        cpus = 1
        memory = '4 GB'
    }
    withLabel: 'process_medium' {
        cpus = 4
        memory = '16 GB'
        time = '8h'
    }
    withLabel: 'process_gpu' {
        cpus = 4
        memory = '32 GB'
        time = '12h'
    }
}
