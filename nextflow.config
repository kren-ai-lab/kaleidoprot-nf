manifest {
    name = 'kren-ai-lab/kaleidoprot-nf'
    description = 'Nextflow pipeline integrating Sylphy, Roxy, Eris and Ruddy for protein representation workflows'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.10.0'
    version = '0.1.0dev'
}

plugins {
    id 'nf-schema@3.1.0'
}

validation {
    // nf-schema flags the keys inside array-of-object params (representations, compositions) as unrecognised;
    // the params block in main.nf rejects unknown params instead.
    logging.unrecognisedParams = 'skip'
}

// Script params are declared in main.nf; these only affect the config (cache_dir is used by both).
params {
    outdir = 'results'
    publish_dir_mode = 'copy'
    cache_dir = null
}

outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

includeConfig 'conf/base.config'

profiles {
    // Each process runs in the released image of its tool (ghcr.io/kren-ai-lab, see modules/).
    docker {
        docker.enabled = true
        // Run as the host user, with HOME in the task directory (on disk, cleaned with work/) for tool caches and logs.
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=$NXF_TASK_WORKDIR' + (params.cache_dir ? " -v ${params.cache_dir}:${params.cache_dir}" : '')
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        // Nextflow runs apptainer with --no-home; HOME goes to the task directory, as in the docker profile.
        apptainer.runOptions = '--home $NXF_TASK_WORKDIR' + (params.cache_dir ? " -B ${params.cache_dir}" : '')
    }
    gpu {
        process {
            withLabel: 'process_gpu' {
                accelerator = 1
            }
        }
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
