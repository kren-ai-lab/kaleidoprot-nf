manifest {
    name = 'kren-ai-lab/kaleidoprot-nf'
    description = 'Nextflow pipeline integrating Sylphy, Roxy, Eris and Ruddy for protein representation workflows'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.04.0'
    version = '0.1.0dev'
}

params {
    // Inputs
    input = null                  // table (csv/tsv/parquet) with columns `id` and `seq_column`; may carry labels
    seq_column = 'sequence'
    label_column = null           // column of `input` used to colour the figures
    structures = null             // Eris manifest: id,path[,chain,model]; relative paths resolve against the manifest

    // Workflow definition (normally given with -params-file, see examples/test/params.yaml)
    representations = []
    compositions = []
    comparisons = 'all'           // 'all' or a list of [x, y] pairs

    // Analysis options
    alignment = 'strict'          // strict: every representation must cover the same ids; partial: intersection
    projection_components = 2     // PCA components of each composition
    comparison_components = 5     // PCA components of each representation; pairs are compared on these scores
    projection_scaling = 'standard'
    mantel_permutations = 999
    eda_max_columns = 5000
    seed = 0
    selection = [
        max_missing: 0.0,         // compositions refuse missing values, so the default drops any column with them
        near_constant: 0.99,
        abs_rho: 0.90,
        method: 'spearman',
        max_features: null,
    ]

    // Output
    outdir = 'results'
    publish_dir_mode = 'copy'
    cache_dir = null              // persistent cache for downloaded models; default: each task downloads its own
}

includeConfig 'conf/base.config'

profiles {
    // Each process runs in the released image of its tool (ghcr.io/kren-ai-lab, see modules/).
    docker {
        docker.enabled = true
        // Run as the host user, with HOME in the task directory (on disk, cleaned with work/) for tool caches and logs.
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=$NXF_TASK_WORKDIR' + (params.cache_dir ? " -v ${params.cache_dir}:${params.cache_dir}" : '')
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = params.cache_dir ? "-B ${params.cache_dir}" : ''
    }
    gpu {
        process {
            withLabel: 'process_gpu' {
                accelerator = 1
            }
        }
    }
    slurm {
        process.executor = 'slurm'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
